# Copy this file to .env and adjust. Every variable is optional.

# Port for the API server (the Vite dev server proxies /api to it).
PORT=3001

# SQLite database file. Created automatically.
DATABASE_PATH=./data/fluent-path.db

# Where speaking recordings are stored.
RECORDINGS_DIR=./data/recordings

# Allow creating extra accounts after the first (admin) account exists.
ALLOW_REGISTRATION=false

# Write module changes made in the admin panel back to content/modules/*.json
# so they survive re-imports and can be version-controlled.
CONTENT_WRITE_BACK=true

# --- Optional AI features (tutor, conversation, AI writing/speaking feedback) ---
# The whole course works without this. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for tutoring and feedback. claude-sonnet-5 is a cheaper alternative.
AI_MODEL=claude-opus-5

# --- Natural voices (neural text-to-speech that runs on this computer) ---
# Set to false to use only the browser's built-in speech engine.
NATURAL_VOICES=true
