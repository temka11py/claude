{
  "name": "fluent-path",
  "private": true,
  "version": "0.1.0",
  "description": "Personal long-term English course: B1 → C1 with spaced repetition, adaptive sessions and CEFR tracking.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/cli/migrate.ts",
    "content:import": "tsx server/cli/import.ts",
    "content:validate": "tsx server/cli/validate.ts",
    "user:reset-password": "tsx server/cli/reset-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "icons": "tsx scripts/make-icons.ts",
    "setup": "npm install && npm run build"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@tanstack/react-query": "^5.103.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
